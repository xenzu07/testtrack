# Copy to .env for local development. In production, set these in the host's
# environment settings instead; never commit real values.

# Supabase Postgres connection (Dashboard > Connect > Session pooler)
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing it signs everyone out.
JWT_SECRET=""

# Supabase Storage (Dashboard > Project Settings > API Keys)
SUPABASE_URL="https://<project-ref>.supabase.co"
# The SECRET / service_role key: backend only. Never put it in the web or mobile app.
SUPABASE_SERVICE_ROLE_KEY=""
# Must match the bucket id in prisma/sql/001_phase1_security.sql
SUPABASE_STORAGE_BUCKET="report-photos"
# How long a photo link stays valid (seconds, 300-86400)
PHOTO_URL_TTL_SECONDS=3600

# Comma-separated browser origins allowed to call the API (the web dashboard).
# Empty = allow any origin (development only).
CORS_ORIGINS="http://localhost:5173"

# Number of reverse-proxy hops in front of the API (usually 1 on a PaaS).
# Leave empty when the API is reached directly.
TRUST_PROXY=

# Serve photos saved on disk before the Supabase Storage move.
# Set to false after `npm run storage:migrate-legacy` reports no failures.
SERVE_LEGACY_UPLOADS=true

# Database connections per backend process. Supabase's session pooler allows
# only 15 for the whole project, shared by every server and script.
DB_POOL_SIZE=5

PORT=3000
