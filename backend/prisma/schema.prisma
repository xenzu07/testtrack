generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  fullName       String
  email          String          @unique
  passwordHash   String
  role           Role
  userType       String?
  isActive       Boolean         @default(true)
  tradeUnitId    String?
  feedback       Feedback[]
  jobs           JobOrder[]      @relation("Technician")
  jobsVerified   JobOrder[]      @relation("Verifier")
  delaysReported MaterialDelay[] @relation("DelayReporter")
  delaysResolved MaterialDelay[] @relation("DelayResolver")
  reports        Report[]        @relation("Reporter")
  tradeUnit      TradeUnit?      @relation(fields: [tradeUnitId], references: [id])
}

model TradeUnit {
  id         String          @id @default(uuid())
  name       String          @unique
  categories IssueCategory[]
  jobOrders  JobOrder[]
  reports    Report[]
  users      User[]
}

model IssueCategory {
  id                 String    @id @default(uuid())
  name               String    @unique
  defaultTradeUnitId String
  defaultTradeUnit   TradeUnit @relation(fields: [defaultTradeUnitId], references: [id])
  reports            Report[]
}

model Location {
  id       String   @id @default(uuid())
  building String
  floor    String
  room     String
  reports  Report[]

  @@unique([building, floor, room])
}

model Report {
  id                  String        @id @default(uuid())
  reporterId          String
  locationId          String
  categoryId          String
  proposedTradeUnitId String
  description         String
  urgency             Urgency
  status              Status        @default(SUBMITTED)
  createdAt           DateTime      @default(now())
  feedback            Feedback?
  jobOrder            JobOrder?
  category            IssueCategory @relation(fields: [categoryId], references: [id])
  location            Location      @relation(fields: [locationId], references: [id])
  proposedTradeUnit   TradeUnit     @relation(fields: [proposedTradeUnitId], references: [id])
  reporter            User          @relation("Reporter", fields: [reporterId], references: [id])
  photos              ReportPhoto[]
  logs                StatusLog[]
}

model ReportPhoto {
  id         String @id @default(uuid())
  reportId   String
  storageUrl String
  report     Report @relation(fields: [reportId], references: [id])
}

model JobOrder {
  id            String          @id @default(uuid())
  jobOrderNo    String          @unique
  reportId      String          @unique
  tradeUnitId   String
  technicianId  String?
  materialsNote String?
  targetDate    DateTime?
  status        Status          @default(ASSIGNED)
  createdById   String
  createdAt     DateTime        @default(now())
  verifiedAt    DateTime?
  verifiedById  String?
  report        Report          @relation(fields: [reportId], references: [id])
  technician    User?           @relation("Technician", fields: [technicianId], references: [id])
  tradeUnit     TradeUnit       @relation(fields: [tradeUnitId], references: [id])
  verifiedBy    User?           @relation("Verifier", fields: [verifiedById], references: [id])
  delays        MaterialDelay[]
}

model StatusLog {
  id          String   @id @default(uuid())
  reportId    String
  oldStatus   Status?
  newStatus   Status
  remarks     String?
  photoUrl    String?
  changedById String
  createdAt   DateTime @default(now())
  report      Report   @relation(fields: [reportId], references: [id])
}

model MaterialDelay {
  id                String    @id @default(uuid())
  jobOrderId        String
  reason            String
  materialsNote     String?
  revisedTargetDate DateTime?
  previousStatus    Status
  reportedById      String
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?
  resolvedById      String?
  jobOrder          JobOrder  @relation(fields: [jobOrderId], references: [id])
  reportedBy        User      @relation("DelayReporter", fields: [reportedById], references: [id])
  resolvedBy        User?     @relation("DelayResolver", fields: [resolvedById], references: [id])
}

model Feedback {
  id         String   @id @default(uuid())
  reportId   String   @unique
  reporterId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  report     Report   @relation(fields: [reportId], references: [id])
  reporter   User     @relation(fields: [reporterId], references: [id])
}

enum Role {
  REPORTER
  TECHNICIAN
  COORDINATOR
  ADMIN
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Status {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  DELAYED
  CLOSED
}
